{
  "name": "momi-ui",
  "version": "0.2.0",
  "description": "Modern Minimal React UI library built on Tailwind CSS v4 — core components and landing page blocks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoangDuong2k/momi-ui.git"
  },
  "homepage": "https://github.com/HoangDuong2k/momi-ui#readme",
  "bugs": {
    "url": "https://github.com/HoangDuong2k/momi-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind.css": "./dist/tailwind.css",
    "./theme.css": "./dist/theme.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types && npm run build:css",
    "build:types": "tsc -p tsconfig.build.json",
    "build:css": "node ./scripts/build-css.mjs",
    "build:playground": "vite build --mode playground",
    "dev:lib": "node ./scripts/dev-lib.mjs",
    "prepare": "node ./scripts/prepare.mjs",
    "preview": "vite preview --outDir playground-dist",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node ./scripts/check-node.mjs",
    "test": "vitest run",
    "pretest:watch": "node ./scripts/check-node.mjs",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwindcss",
    "design-system",
    "landing-page",
    "minimal",
    "radix-ui",
    "data-table",
    "date-picker",
    "command-palette"
  ],
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react-resizable-panels": "^4.14.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.52.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
